# Admin (see docs/ADMIN.md). Set these in Vercel → Project → Settings → Environment Variables.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Fine-grained token: this repository only, "Contents: Read and write".
GITHUB_TOKEN=
# Comma-separated GitHub usernames allowed into /admin.
ADMIN_GITHUB_USERS=BrandonT-ops
# At least 32 random characters, e.g. `openssl rand -base64 32`.
SESSION_SECRET=
# Optional
GITHUB_REPO=BrandonT-ops/LazyChef
GITHUB_BRANCH=
